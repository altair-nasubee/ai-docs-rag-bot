# Streamlit Community Cloud / Hugging Face Spaces の Secrets に貼り付ける内容のサンプル。
# 実体（secrets.toml）はコミットしない（.gitignore で除外済み）。
# 埋め込みはローカル ONNX のため、必要なキーは Groq のみ。

GROQ_API_KEY = "your-groq-api-key"

# 任意（未設定なら config.py の既定値が使われる）
# GROQ_MODEL は Groq ホストのモデル。GROQ_API_KEY だけで動く（OpenAI キー不要）。
# 旧既定 llama-3.3-70b-versatile は 2026-08-16 に終了済み（404）。
GROQ_MODEL = "openai/gpt-oss-120b"
# gpt-oss 系（推論モデル）。小さいと出力が途中で切れ、大きすぎると TPM 上限
# （無料枠8000）で 413。取り込みプロンプト圧縮後は 3072 が最適（413回避＋出力完結）。
GROQ_MAX_TOKENS = "3072"
GROQ_REASONING_EFFORT = "low"
EMBED_MODEL = "intfloat/multilingual-e5-small"
EMBED_DIM = "384"
