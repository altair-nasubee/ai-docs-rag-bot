# ===== API キー =====
# Groq（回答生成 LLM）: https://console.groq.com/keys で取得
# 埋め込みはローカル ONNX（fastembed）で計算するためキー不要。必要なのはこれだけ。
GROQ_API_KEY=your-groq-api-key

# ===== モデル設定（未設定なら既定値が使われる）=====
# 回答生成 LLM（Groq がホスト。GROQ_API_KEY だけで利用可、OpenAI キーは不要）。
# 旧既定 llama-3.3-70b-versatile は Groq が 2026-08-16 に終了し 404 になるため使用不可。
# 代替: qwen/qwen3.6-27b（多言語重視・Preview）/ openai/gpt-oss-20b（高速・軽量）
GROQ_MODEL=openai/gpt-oss-120b

# gpt-oss 系は推論モデル。小さいと思考で使い切り JSON が途中で切れ、大きすぎると
# TPM 上限（無料枠8000）に対し「prompt + max_tokens」で 413。取り込み最大プロンプト
# （カテゴリ体系生成）は ingest 側で圧縮済み(prompt≒4074)。3072 で 413回避＋出力完結。
GROQ_MAX_TOKENS=3072

# 推論の強さ。gpt-oss 系は low/medium/high、Qwen 系は none/default。
# 定型 JSON 生成・RAG 回答では low で十分（速く・トークン節約）。
GROQ_REASONING_EFFORT=low

# 埋め込みモデル（fastembed のローカル ONNX）。多言語・クロスリンガル対応。
EMBED_MODEL=intfloat/multilingual-e5-small

# 埋め込み次元数
EMBED_DIM=384

# e5 系の必須プレフィックス。プレフィックス不要モデルに切替える場合は両方を空にする。
# EMBED_QUERY_PREFIX=query:
# EMBED_PASSAGE_PREFIX=passage:

# git push space main の実行時の Username と Pass
HF_USER=<USERNAME of Hugging Face Spaces>
HF_TOKEN=<TOKEN of Hugging Face Spaces>
